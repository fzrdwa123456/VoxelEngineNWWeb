{
  "name": "voxelenginenwweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build-all": "node scripts/build-all.mjs",
    "check": "node scripts/build-all.mjs --check-only",
    "build": "tsc && vite build && node scripts/rearrange.mjs && gcc -O2 -municode -mwindows -o release/VoxelEngineNWWeb/launcher.exe launcher/launcher.c",
    "build:cursor": "gcc -O2 -mwindows -o release/VoxelEngineNWWeb/game/core/cursor.exe launcher/cursor.c",
    "build:winctl": "gcc -O2 -s -mwindows -o release/VoxelEngineNWWeb/game/core/winctl.exe launcher/winctl.c",
    "get-nw": "node scripts/get-nw.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.4",
    "rcedit": "^5.0.2",
    "resedit": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-monospaced-sc": "^5.3.0",
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "fflate": "^0.8.3",
    "onnxruntime-web": "^1.29.0",
    "three": "^0.185.1",
    "vgpu": "^0.4.0"
  }
}
