{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxelEngineTauri",
  "version": "1.0.0",
  "identifier": "com.voxelengine.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxelEngine",
        "width": 1280,
        "height": 720,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#000000",
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
